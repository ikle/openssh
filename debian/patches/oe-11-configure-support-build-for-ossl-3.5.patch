From: "Alexei A. Smekalkine" <smekalkin@numatech.ru>
Date: Tue, 16 Sep 2025 13:02:51 +0300
Subject: [PATCH 2/2] configure: support build for ossl 3.5

---
 configure.ac | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/configure.ac b/configure.ac
index 15fc0d6..800941d 100644
--- a/configure.ac
+++ b/configure.ac
@@ -2831,7 +2831,7 @@ if test "x$openssl" = "xyes" ; then
 				;;
 			101*)   ;; # 1.1.x
 			200*)   ;; # LibreSSL
-			300*)   ;; # OpenSSL development branch.
+			30*)   ;; # OpenSSL development branch.
 		        *)
 				AC_MSG_ERROR([Unknown/unsupported OpenSSL version ("$ssl_library_ver")])
 		                ;;
